# ─────────────────────────────────────────────────────────────────────────────
# Raven Backend — ONE env file for all environments
# Copy to .env on the server and fill in real values.
# APP_ENV tells Django which DB block to use.
# NEVER commit a real .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# Which environment is this server running?  staging | production
APP_ENV=production

# Django core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=api.raven-emrc.com,31.97.56.29

# ── Staging PostgreSQL ────────────────────────────────────────────────────────
STAGING_DB_NAME=raven_db_staging
STAGING_DB_USER=postgres
STAGING_DB_PASSWORD=your-staging-postgres-password
STAGING_DB_HOST=31.97.56.29
STAGING_DB_PORT=5432

# ── Production PostgreSQL ─────────────────────────────────────────────────────
PRODUCTION_DB_NAME=raven_db
PRODUCTION_DB_USER=postgres
PRODUCTION_DB_PASSWORD=your-production-postgres-password
PRODUCTION_DB_HOST=31.97.56.29
PRODUCTION_DB_PORT=5432

# ── External DataNest MySQL (shared — same on staging and production) ─────────
EX_DB_NAME=dataNestDB_KEDCO
EX_DB_USER=root
EX_DB_PASSWORD=your-mysql-password
EX_DB_HOST=31.97.56.29
EX_DB_PORT=3306
EX_DB_MAX_POOL=10

# ── Keycloak SSO ──────────────────────────────────────────────────────────────
# Realm endpoint — used to fetch the RS256 public key for JWT validation
KEYCLOAK_REALM_URL=http://31.97.56.29:8083/realms/KEDCO

# Client credentials for the 'raven' client configured in Keycloak
KEYCLOAK_CLIENT_ID=raven
KEYCLOAK_CLIENT_SECRET=your-raven-client-secret-from-keycloak

# Callback URL Keycloak redirects to after login — MUST match Keycloak client → Valid Redirect URIs
KEYCLOAK_REDIRECT_URI=http://31.97.56.29:8096/api/auth/sso/callback

# Raven frontend URL — backend sends the user here after successful Keycloak login
RAVEN_FRONTEND_URL=https://kedco.raven-emrc.com

# DataNest SSO handoff — Raven forwards the Keycloak token here when linking to DataNest
DATANEST_SSO_URL=http://31.97.56.29:8000/api/auth/sso/verify

# ── Application URLs ──────────────────────────────────────────────────────────
# staging → https://staging.raven-emrc.com | production → https://api.raven-emrc.com
BASE_URL=https://api.raven-emrc.com
VISUALIZATION_API_URL=https://api.raven-emrc.com

# ── Gunicorn ──────────────────────────────────────────────────────────────────
# staging: 2 | production: 4
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120

# ── Keycloak admin (docker-compose only — not read by Django) ─────────────────
KC_ADMIN=admin
KC_ADMIN_PASSWORD=change-me-keycloak-admin-password
# production only — leave blank on staging
KC_HOSTNAME=
KC_DB_USER=
KC_DB_PASSWORD=
